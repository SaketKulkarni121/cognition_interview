// Internal Operations Platform — data model.
// SQLite does not support native enums, so status/role/action columns are
// strings validated in the application layer (see src/modules/*/workflow.ts
// and src/lib/auth/permissions.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  role      String // ADMIN | ANALYST | VIEWER
  title     String?
  createdAt DateTime @default(now())

  assignedApplications KycApplication[] @relation("AssignedReviewer")
  notes                KycNote[]
  decisions            KycDecision[]
  auditLogs            AuditLog[]
  refundNotes          RefundNote[]
  refundDecisions      RefundDecision[]
  refundPayouts        RefundPayout[]
  flagChanges          FeatureFlagEnvironment[]
}

model KycApplication {
  id                    String    @id @default(cuid())
  reference             String    @unique
  status                String    @default("SUBMITTED")
  firstName             String
  lastName              String
  email                 String
  phone                 String
  dateOfBirth           DateTime
  nationality           String
  addressLine1          String
  addressLine2          String?
  city                  String
  region                String
  postalCode            String
  country               String
  occupation            String
  employer              String?
  sourceOfFunds         String
  expectedMonthlyVolume String
  accountPurpose        String
  taxIdLast4            String
  submittedAt           DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  decidedAt             DateTime?

  assignedReviewerId String?
  assignedReviewer   User?   @relation("AssignedReviewer", fields: [assignedReviewerId], references: [id])

  documents KycDocument[]
  notes     KycNote[]
  decisions KycDecision[]

  @@index([status])
  @@index([assignedReviewerId])
  @@index([submittedAt])
}

model KycDocument {
  id             String    @id @default(cuid())
  applicationId  String
  type           String // PASSPORT | DRIVERS_LICENSE | NATIONAL_ID | PROOF_OF_ADDRESS
  fileName       String
  documentNumber String?
  issuingCountry String?
  issuedAt       DateTime?
  expiresAt      DateTime?
  uploadedAt     DateTime  @default(now())

  application KycApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

model KycNote {
  id            String   @id @default(cuid())
  applicationId String
  authorId      String
  body          String
  createdAt     DateTime @default(now())

  application KycApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  author      User           @relation(fields: [authorId], references: [id])

  @@index([applicationId])
}

model KycDecision {
  id            String   @id @default(cuid())
  applicationId String
  reviewerId    String
  action        String // APPROVE | REJECT | REQUEST_INFO | ESCALATE | RESUME_REVIEW
  fromStatus    String
  toStatus      String
  reason        String
  createdAt     DateTime @default(now())

  application KycApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  reviewer    User           @relation(fields: [reviewerId], references: [id])

  @@index([applicationId])
}

// ---------------------------------------------------------------------------
// Refunds module. Money is stored as integer minor units (cents).
// ---------------------------------------------------------------------------

model PaymentTransaction {
  id            String   @id @default(cuid())
  reference     String   @unique
  merchantName  String
  description   String
  orderNumber   String?
  amount        Int
  taxAmount     Int      @default(0)
  currency      String   @default("USD")
  paymentMethod String
  purchasedAt   DateTime
  lineItems     String // JSON: [{ name, quantity, unitAmount }]

  refundCases RefundCase[]
}

model RefundCase {
  id               String    @id @default(cuid())
  reference        String    @unique
  status           String    @default("PENDING") // PENDING | ESCALATED | APPROVED | REJECTED
  customerName     String
  customerEmail    String
  customerId       String
  customerSince    DateTime
  amountRequested  Int
  currency         String    @default("USD")
  reasonCategory   String
  complaint        String
  channel          String // EMAIL | CHAT | PHONE
  supportAgentName String
  supportAgentTeam String
  supportTicketRef String
  eligibilityNote  String?
  submittedAt      DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  decidedAt        DateTime?

  transactionId String
  transaction   PaymentTransaction @relation(fields: [transactionId], references: [id])

  notes     RefundNote[]
  decisions RefundDecision[]
  payout    RefundPayout?

  @@index([status])
  @@index([submittedAt])
  @@index([transactionId])
}

model RefundNote {
  id          String   @id @default(cuid())
  caseId      String
  kind        String // SUPPORT | REVIEWER
  authorId    String?
  authorName  String
  authorTitle String?
  body        String
  createdAt   DateTime @default(now())

  case   RefundCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  author User?      @relation(fields: [authorId], references: [id])

  @@index([caseId])
}

model RefundDecision {
  id         String   @id @default(cuid())
  caseId     String
  reviewerId String
  action     String // APPROVE | REJECT | ESCALATE
  fromStatus String
  toStatus   String
  reason     String
  createdAt  DateTime @default(now())

  case     RefundCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  reviewer User       @relation(fields: [reviewerId], references: [id])

  @@index([caseId])
}

// One row per executed refund. The unique caseId and idempotencyKey make it
// impossible to record (or send) a second refund for the same case.
model RefundPayout {
  id               String    @id @default(cuid())
  caseId           String    @unique
  idempotencyKey   String    @unique
  provider         String
  providerRefundId String?
  amount           Int
  currency         String
  status           String // PROCESSING | SUCCEEDED | FAILED
  attempts         Int       @default(0)
  lastError        String?
  requestedById    String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  completedAt      DateTime?

  case        RefundCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  requestedBy User       @relation(fields: [requestedById], references: [id])
}

// ---------------------------------------------------------------------------
// Feature flags module. Simple boolean on/off per environment.
// ---------------------------------------------------------------------------

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique // e.g. "instant_refunds"; what application code queries
  name        String
  description String
  ownerTeam   String
  createdAt   DateTime @default(now())

  environments FeatureFlagEnvironment[]
}

model FeatureFlagEnvironment {
  id          String   @id @default(cuid())
  flagId      String
  environment String // DEVELOPMENT | STAGING | PRODUCTION
  enabled     Boolean  @default(false)
  version     Int      @default(1) // optimistic concurrency guard
  updatedAt   DateTime @default(now())
  updatedById String?

  flag      FeatureFlag @relation(fields: [flagId], references: [id], onDelete: Cascade)
  updatedBy User?       @relation(fields: [updatedById], references: [id])

  @@unique([flagId, environment])
  @@index([environment])
}

// Append-only, platform-wide audit trail shared by every internal app.
// Actor name/role are snapshotted so history stays accurate if users change.
model AuditLog {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  actorId    String?
  actorName  String
  actorRole  String
  module     String // e.g. "kyc"
  action     String // e.g. "kyc.application.approved"
  entityType String
  entityId   String
  entityRef  String?
  fromStatus String?
  toStatus   String?
  reason     String?
  metadata   String? // JSON

  actor User? @relation(fields: [actorId], references: [id])

  @@index([module, createdAt])
  @@index([entityType, entityId])
}
